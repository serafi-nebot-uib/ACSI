/DECLARE/ QUEUE CPU(2),DISC(2),TERMINAL;
          REAL V_DISC(2)=(7.,1.),V_TERM=1.;
          REAL V_TOTAL=V_DISC(1) + V_DISC(2) + V_TERM;
          REAL V_CPU(2)=(V_TOTAL/2, V_TOTAL/2);
          REAL T_R,T_T,T_Z,WORK;
          INTEGER I,N1;
/STATION/ NAME=CPU;
&         SCHED=PS;
          TRANSIT=DISC,V_DISC,TERMINAL,1;
/STATION/ NAME=CPU(1);
          SERVICE=EXP(0.005);
/STATION/ NAME=CPU(2);
          SERVICE=EXP(0.005);
/STATION/ NAME=DISC;
          TRANSIT=CPU,V_CPU;
/STATION/ NAME=DISC(1);
          SERVICE=EXP(0.02);
/STATION/ NAME=DISC(2);
          SERVICE=EXP(0.3);
/STATION/ NAME=TERMINAL;
          TYPE=INFINITE;
          INIT=N1;
          SERVICE=EXP(8.);
          TRANSIT=CPU,V_CPU;
/CONTROL/ CLASS=ALL QUEUE;
/EXEC/    FOR N1:=20 STEP 10 UNTIL 20 DO
          BEGIN
            PRINT;
            PRINT("NUMERO DE USUARIOS=",N1);
            SOLVE;

            PRINT("");
            PRINT("---------- DEMANDAS DE LOS DISPOSITIVOS ----------");
            PRINT("Demanda CPU1  = ", MSERVICE(CPU(1)) * V_CPU(1));
            PRINT("Demanda CPU2  = ", MSERVICE(CPU(2)) * V_CPU(2));
            PRINT("Demanda DISC1 = ", MSERVICE(DISC(1)) * V_DISC(1));
            PRINT("Demanda DISC2 = ", MSERVICE(DISC(2)) * V_DISC(2));
            PRINT("---------------------------------------------------");

            T_Z := MSERVICE(TERMINAL);
            T_R := N1 / MTHRUPUT(TERMINAL) - T_Z;
            T_T := T_R + T_Z;
            WORK := MTHRUPUT(TERMINAL) * T_R;

            PRINT("");
            PRINT("-------------- TIEMPOS DE RESPUESTA ---------------");
            PRINT("Tiempo de respuesta del sistema (R) = ", T_R);
            PRINT("Tiempo de reflexion (Z)             = ", T_Z);
            PRINT("Tiempo TOTAL (R+Z)                  = ", T_T);
            PRINT("Número de usuarios trabajando       = ", WORK);
            PRINT("---------------------------------------------------");

            PRINT("");
            PRINT("---------- PROBABILIDADES DE ENCAMINAMIENTO ----------");
            PRINT("Probabilidad CPU1 -> DISC1    = ", V_DISC(1) / V_TOTAL);
            PRINT("Probabilidad CPU1 -> DISC2    = ", V_DISC(2) / V_TOTAL);
            PRINT("Probabilidad CPU1 -> TERMINAL = ", V_TERM / V_TOTAL);
            PRINT("Probabilidad CPU2 -> DISC1    = ", V_DISC(1) / V_TOTAL);
            PRINT("Probabilidad CPU2 -> DISC2    = ", V_DISC(2) / V_TOTAL);
            PRINT("Probabilidad CPU2 -> TERMINAL = ", V_TERM / V_TOTAL);
            PRINT("Probabilidad DISC1 -> CPU1    = ", 1.0);
            PRINT("Probabilidad DISC2 -> CPU1   = ", 1.0);
            PRINT("Probabilidad TERMINAL -> CPU1 = ", 1.0);
            PRINT("Probabilidad DISC1 -> CPU2    = ", 1.0);
            PRINT("Probabilidad DISC2 -> CPU2   = ", 1.0);
            PRINT("Probabilidad TERMINAL -> CPU2 = ", 1.0);
            PRINT("----------------------------------------------------");
          END;
/END/
