      1 /DECLARE/ QUEUE CPU,DISC(2),TERMINAL;
      2           REAL V_DISC(2)=(7.,1.),V_TERM=1.;
      3           REAL V_CPU=V_DISC(1) + V_DISC(2) + V_TERM;
      4           REAL V_TOTAL=V_DISC(1) + V_DISC(2) + V_TERM;
      5           REAL T_R,T_T,T_Z,WORK;
      6           INTEGER I,N1;
      7 /STATION/ NAME=CPU;
      8 &         SCHED=PS;
      9           SERVICE=EXP(0.005);
     10           TRANSIT=DISC,V_DISC,TERMINAL,1;
     11 /STATION/ NAME=DISC;
     12           TRANSIT=CPU;
     13 /STATION/ NAME=DISC(1);
     14           SERVICE=EXP(0.02);
     15 /STATION/ NAME=DISC(2);
     16           SERVICE=EXP(0.3);
     17 /STATION/ NAME=TERMINAL;
