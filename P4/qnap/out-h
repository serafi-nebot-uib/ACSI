     33             PRINT("Demanda DISC2 = ", MSERVICE(DISC(2)) * V_DISC(2));
     34             PRINT("---------------------------------------------------")
;
     35  
     36             T_Z := MSERVICE(TERMINAL);
     37             T_R := N1 / MTHRUPUT(TERMINAL) - T_Z;
     38             T_T := T_R + T_Z;
     39             WORK := MTHRUPUT(TERMINAL) * T_Z;
     40  
     41             PRINT("");
     42             PRINT("-------------- TIEMPOS DE RESPUESTA ---------------")
;
     43             PRINT("Tiempo de respuesta del sistema (R) = ", T_R);
     44             PRINT("Tiempo de reflexion (Z)             = ", T_Z);
     45             PRINT("Tiempo TOTAL (R+Z)                  = ", T_T);
     46             PRINT("Número de usuarios trabajando       = ", WORK);
     47             PRINT("---------------------------------------------------")
;
     48  
     49             PRINT("");
     50             PRINT("---------- PROBABILIDADES DE ENCAMINAMIENTO ---------
-");
     51             PRINT("Probabilidad CPU -> DISC1    = ", V_DISC(1) / V_TOTAL
);
     52             PRINT("Probabilidad CPU -> DISC2    = ", V_DISC(2) / V_TOTAL
);
     53             PRINT("Probabilidad CPU -> TERMINAL = ", V_TERM / V_TOTAL);
     54             PRINT("Probabilidad DISC1 -> CPU    = ", 1.0);
     55             PRINT("Probabilidad DISC2 -> CPU    = ", 1.0);
     56             PRINT("Probabilidad TERMINAL -> CPU = ", 1.0);
     57             PRINT("----------------------------------------------------"
);
     58           END;
 
