     24             PRINT;
     25             PRINT("NUMERO DE USUARIOS=",N);
     26             SOLVE;
     27  
     28             X := MTHRUPUT(TERMINAL);
     29             X1 := MTHRUPUT(CPU);
     30             X2 := MTHRUPUT(DISC(1));
     31             X3 := MTHRUPUT(DISC(2));
     32             R := N / X - Z;
     33             R1 := MRESPONS(CPU);
     34             R2 := MRESPONS(DISC(1));
     35             R3 := MRESPONS(DISC(2));
     36             N1 := X1 * R1;
     37             N2 := X2 * R2;
     38             N3 := X2 * R3;
     39  
     40             PRINT("R1 = ", R1);
     41             PRINT("R2 = ", R2);
     42             PRINT("R3 = ", R3);
     43             PRINT("X = ", X);
     44             PRINT("R  = ", R);
     45             PRINT("N1 = ", N1);
     46             PRINT("N2 = ", N2);
     47             PRINT("N3 = ", N3);
     48           END;
 
